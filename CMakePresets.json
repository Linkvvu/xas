{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc2017",
      "hidden": true,
      "generator": "Visual Studio 15 2017",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "ygx-proj",
      "inherits": [
        "msvc2017",
        "vcpkg"
      ],
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "v141",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "x64,version=10.0.19041.0",
        "YGX_PROJ_DIR": "$env{YGX_PROJ_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "ygx-proj",
      "configuration": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "ygx-proj",
      "configuration": "Release"
    }
  ]
}